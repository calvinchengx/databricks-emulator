# The compute sidecars every e2e compose file attaches, from ONE fabric-emulator
# release. Same shape as versions.env in the databricks platforms, so a bump
# there can be copied here line for line.
#
#   _VERSION  the tag: the dependency the image carries (pysail, pyspark-client)
#   _DIGEST   the identity: which build exactly -- the tag is rebuilt and
#             overwritten by every fabric-emulator release
#   _RELEASE  the fabric-emulator release that published that digest
#
# The compose files cannot read this file, so each repeats these values as its
# `${VAR:-default}`. scripts/check_sidecar_pins.py fails when any of them
# disagrees with this file, and with --registry also when _RELEASE did not
# publish _DIGEST. To bump: edit here, copy the defaults into every
# e2e/*/docker-compose.yml, run `make pins`.
SAIL_ENGINE_VERSION=0.7.1
SAIL_ENGINE_DIGEST=sha256:0b37f65f41da5d9493f3e5a5479a622b14ba6ca51492b5a0ab886ed1ffcbb430
SAIL_ENGINE_RELEASE=0.36.0
SPARK_CLIENT_VERSION=4.2.0
SPARK_CLIENT_DIGEST=sha256:04509791f172cf11fd08b5aa7277af64079a8d142e9abdfda222aef9ee347bd9
SPARK_CLIENT_RELEASE=0.36.0
