# Runtime state — the emulator's store, created at the repo root on first run.
# Anchored with a leading slash: a bare `data/` matches a directory of that name
# at ANY depth.
/data/
*.log

# Locally built binary (`make build`, or `go build ./cmd/...`).
# Windows appends .exe; ignoring only the bare name leaves a binary for
# `git add -A` to pick up.
/databricks-emulator
/databricks-emulator.exe

# Node
node_modules/

# Python
.venv/
__pycache__/
# setuptools artifacts from the packages under python/ (scripts/build_target_wheel.py,
# or an editable install). `build/` is scoped the way `/data/` is: bare, it would
# match any directory of that name at any depth, including the docs site's output.
# `*.egg-info/` is unambiguous enough to leave unanchored.
/python/*/build/
*.egg-info/

# Local tooling
.claude/
.nwave/

# GoReleaser build output
/dist/

# Go coverage profile
cover.out
